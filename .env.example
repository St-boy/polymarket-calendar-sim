# Optional: explicit raw URL to sim-state.json on GitHub
# SIM_STATE_URL=https://raw.githubusercontent.com/<YOU>/<REPO>/main/data/sim-state.json

# Optional helpers if Vercel cannot infer repo
# SIM_REPO_OWNER=
# SIM_REPO_NAME=
# SIM_REPO_BRANCH=main

# Optional: protect /api/reset and manual /api/scan
# CRON_SECRET=

# Optional Upstash (NOT required for the GitHub Actions architecture)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
